# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_password_before_starting
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# LLM opcional (endpoint compatível com OpenAI Chat Completions).
# Sem as três variáveis abaixo, o app usa síntese determinística e avisa o usuário.
LLM_CHAT_COMPLETIONS_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45
