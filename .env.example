# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_this_password_before_starting
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# LLM opcional (endpoint compatível com OpenAI Chat Completions).
# Síntese em linguagem natural: evidências só são enviadas com opt-in explícito.
LLM_CHAT_COMPLETIONS_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_SEND_EVIDENCE=false
LLM_TIMEOUT_SECONDS=45

# Geração de Cypher: desligada por padrão.
# Requer configuração acima e ativação deliberada de LLM_CYPHER_ENABLED=true.
# A consulta gerada é validada e executada apenas para leitura.
LLM_CYPHER_ENABLED=false
